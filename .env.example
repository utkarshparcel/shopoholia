# WORN local development environment
# Copy to repo root as .env when apps/services are scaffolded

NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://worn:worn@localhost:5432/worn
REDIS_URL=redis://localhost:6379

# Signs API access tokens (the API also accepts the older name JWT_SECRET).
JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars!!
# Not read by the API yet: refresh tokens are random values stored hashed in Postgres.
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars!

# PORT / HOST, when a hosting platform sets them, take precedence.
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=*

# Cloudflare R2 (optional until storage is wired)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# OTP (optional — prefer Google Sign-In; leave unset to avoid SMS spend)
# MSG91_AUTH_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Google Sign-In (comma-separated OAuth client IDs: web, iOS, Android)
# GOOGLE_CLIENT_IDS=xxxxx.apps.googleusercontent.com,yyyyy.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_DEV_AUTO_AUTH=1

# --- Gmail OAuth / ingestion connector (Universe P0) ---
# Client id used to build the OAuth URL returned by POST /ingestion/sources.
# Falls back to a placeholder outside production; in production, unset means Gmail connect
# answers 503. Also used by worker-ingest Gmail connector.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# HMAC key for the OAuth state (single-use, 10-minute). Required in production: no fallback there.
# OAUTH_STATE_SECRET=
# Required for auth-code → token exchange on GET /ingestion/sources/oauth/callback
# and for refresh-token renewal in worker-ingest.
# GOOGLE_CLIENT_SECRET=
# AES key material for encrypting OAuth tokens at rest (worker-ingest crypto).
# Must be set in any env that persists Gmail tokens.
# OAUTH_TOKEN_SECRET=dev-oauth-token-secret-change-me-32b
# To rotate: move the old secret here (comma-separated) and set a new OAUTH_TOKEN_SECRET.
# Old tokens still decrypt; refreshed tokens are re-encrypted with the new one.
# OAUTH_TOKEN_SECRET_PREVIOUS=
# Public base URL used in the Gmail OAuth redirect (defaults to https://api.shopoholia.app)
# API_PUBLIC_URL=https://api.shopoholia.app

# Ingest webhook shared secret (POST /webhooks/email). Required in non-dev envs.
# INGEST_WEBHOOK_SECRET=change-me-ingest-webhook-secret

# Redis for BullMQ workers (each falls back to REDIS_URL if unset)
# Loyalty points + promo/coupon credits use the same money vault / credit-expiry
# path as gift cards — no extra env vars required.
# INGEST_REDIS_URL=redis://localhost:6379
# EXPIRY_REDIS_URL=redis://localhost:6379
# WARDROBE_REDIS_URL=redis://localhost:6379
# RETURN_REDIS_URL=redis://localhost:6379
# GIFT_REDIS_URL=redis://localhost:6379
# TAILORING_REDIS_URL=redis://localhost:6379

# Raw ingestion_documents retention (days). Per-kind defaults: EMAIL 7 / SMS 14 / RECEIPT 30.
# INGESTION_RETENTION_DAYS=30
# INGESTION_RETENTION_DAYS_EMAIL=7
# INGESTION_RETENTION_DAYS_SMS=14
# INGESTION_RETENTION_DAYS_RECEIPT=30

# Render providers (optional until Week 2 spike)
# FASHN_API_KEY=
# COMFYUI_BASE_URL=

# Push notifications go through Expo's push service. Optional: only needed once
# "enhanced push security" is turned on for the Expo project (expo.dev access tokens).
# EXPO_ACCESS_TOKEN=

# Closet outfit weather (optional). URL may include {lat}/{lon} placeholders.
# When unset, outfits use a deterministic mock from date+lat (tempC, condition, source).
# WEATHER_API=https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m,weather_code

# Observability (optional — each is a no-op until its key is set)
# API: 5xx request errors and failed background jobs → Sentry
# SENTRY_DSN=
# Mobile: crashes, uncaught JS errors and render errors → Sentry
# EXPO_PUBLIC_SENTRY_DSN=
# Mobile: funnel events (trackEvent) → PostHog project API key; without it, events go to the console in dev
# EXPO_PUBLIC_POSTHOG_KEY=phc_xxxxxxxx
# EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Mobile: a generic analytics webhook instead; takes precedence over PostHog when set
# EXPO_PUBLIC_ANALYTICS_WEBHOOK_URL=
# Preview smoke: set =1 once to emit worn.smoke.* test event
# SENTRY_SMOKE=1
# EXPO_PUBLIC_SENTRY_SMOKE=1

# Server analytics (apps/api, optional — console sink without these): prefer ANALYTICS_WEBHOOK_URL, else POSTHOG_KEY
# ANALYTICS_WEBHOOK_URL=
# POSTHOG_KEY=
# POSTHOG_HOST=https://us.i.posthog.com
# Props are sanitized (no email/phone/token/card) before send.

# Receipt OCR provider (Universe P1.2).
# Hosted is used automatically when OCR_PROVIDER_URL is set; otherwise mock
# (deterministic, no external dependency). Force mock with OCR_PROVIDER=mock.
# Optional OCR_PROVIDER_API_KEY is sent as Bearer. Optional
# OCR_PROVIDER_FORMAT=google-vision maps Vision annotate responses; default
# format is generic JSON { imageKey } → { merchant, items, confidence }.
# Confidence is always returned (mock ≈ 0.92). Mobile blocks confirm below
# OCR_CONFIRM_CONFIDENCE_THRESHOLD (0.7) unless the user overrides.
# OCR_PROVIDER=mock
# OCR_PROVIDER_URL=
# OCR_PROVIDER_API_KEY=
# OCR_PROVIDER_FORMAT=generic
# OCR_PROVIDER_ENDPOINT=   # alias for OCR_PROVIDER_URL (legacy)

# WV02-BALANCE-CHECK — optional hosted merchant balance refresh.
# When set, POST { merchant, currency, hintBalanceMinor } → { balanceMinor }.
# Without URL, api-capable merchants (Amazon/Flipkart) use an in-process stub.
# MERCHANT_BALANCE_API_URL=
# MERCHANT_BALANCE_STUB_MINOR=   # optional override for stub responses

# Mobile feature flags / API
# EXPO_PUBLIC_API_URL=http://localhost:3000
# EXPO_PUBLIC_FEATURE_CLOSET=1
# EXPO_PUBLIC_PRIVACY_URL=https://worn.app/privacy
# EXPO_PUBLIC_FORWARDING_ADDRESS=forward@inbox.shopoholia.app

# --- Monetization (scaffold — no store secrets required) ---
# FEATURE_PREMIUM_GATES=1
# FEATURE_TAKE_RATE=1
# FEATURE_UPI=1
# EXPERIMENT_UPI_CHECKOUT=1
# WORN_REGION=IN
# RAZORPAY_KEY_ID=             # optional public key hint only; never commit secrets
# Store purchases (coins, Closet premium), verified with Apple and Google directly. A store without
# its settings is unavailable (503 for that store). App Store needs no API key.
# APPLE_BUNDLE_ID=com.shopoholia.worn
# ANDROID_PACKAGE_NAME=com.shopoholia.worn
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=   # service-account key JSON (one line) with Play Console access
# IAP_ALLOW_SIMULATED=1        # dev only (ignored in production): accept `simulated-` transaction ids
# IAP_ALLOW_XCODE=1            # dev only: accept StoreKit Testing in Xcode, signed by IAP_XCODE_CERT_PEM
# IAP_XCODE_CERT_PEM=          # Xcode: Editor > Save Public Certificate (PEM, \n escapes allowed)
# GOOGLE_PLAY_API_BASE_URL=    # dev only: point the Play Developer API at a local fake
# EXPO_PUBLIC_FEATURE_REVENUECAT=1
# EXPO_PUBLIC_FEATURE_PAYWALL=1
# EXPO_PUBLIC_FEATURE_PREMIUM_GATES=1
# EXPO_PUBLIC_FEATURE_UPI=1
# EXPO_PUBLIC_EXPERIMENT_UPI_CHECKOUT=1
# EXPO_PUBLIC_WORN_REGION=IN
# EXPO_PUBLIC_REVENUECAT_API_KEY=   # public SDK key when wiring Purchases; omit in CI
