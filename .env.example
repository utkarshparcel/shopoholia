# WORN local development environment
# Copy to repo root as .env when apps/services are scaffolded

NODE_ENV=development
LOG_LEVEL=debug

DATABASE_URL=postgresql://worn:worn@localhost:5432/worn
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=dev-access-secret-change-me-32chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-32chars!

API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=*

# Cloudflare R2 (optional until storage is wired)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_URL=

# OTP (optional — prefer Google Sign-In; leave unset to avoid SMS spend)
# MSG91_AUTH_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# Google Sign-In (comma-separated OAuth client IDs: web, iOS, Android)
# GOOGLE_CLIENT_IDS=xxxxx.apps.googleusercontent.com,yyyyy.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_DEV_AUTO_AUTH=1

# Render providers (optional until Week 2 spike)
# FASHN_API_KEY=
# COMFYUI_BASE_URL=

# Observability (optional — no-op without DSN)
# SENTRY_DSN=
# EXPO_PUBLIC_SENTRY_DSN=
