{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worn-web",
  "compatibility_date": "2026-10-15",
  // Keep the workers.dev URL alive next to the custom domain (a custom domain turns it off by default).
  "workers_dev": true,
  "preview_urls": true,
  // The static export (`next build` writes it to ./out) plus one small Worker, worker/index.ts, that
  // Cloudflare runs for /api/* only: the early-access form posts there. Everything else is served
  // straight from the assets.
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // Sign-ups are emailed to the inbox in the JOIN_TO secret (`wrangler secret put JOIN_TO`). It has to
  // be a verified Email Routing destination address: sending to one is free, with no mail provider.
  "send_email": [{ "name": "EMAIL" }],
  // At most five sign-ups a minute from one IP address.
  "ratelimits": [{ "name": "JOIN_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  "observability": { "enabled": true },
  // worncloset.app is a zone in the same account; www redirects to it with a zone Redirect Rule.
  "routes": [{ "pattern": "worncloset.app", "custom_domain": true }]
}
