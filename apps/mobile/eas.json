{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "testflight": {
      "extends": "preview",
      "distribution": "store",
      "ios": {
        "simulator": false
      },
      "channel": "beta"
    },
    "play-internal": {
      "extends": "preview",
      "distribution": "internal",
      "android": {
        "buildType": "app-bundle"
      },
      "channel": "beta"
    }
  },
  "submit": {
    "testflight": {
      "ios": {
        "appleId": "${APPLE_ID}",
        "ascAppId": "${ASC_APP_ID}",
        "appleTeamId": "${APPLE_TEAM_ID}"
      }
    },
    "play-internal": {
      "android": {
        "serviceAccountKeyPath": "${GOOGLE_SERVICE_ACCOUNT_KEY_PATH}",
        "track": "internal"
      }
    }
  }
}
