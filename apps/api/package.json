{
  "name": "@worn/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx scripts/seed-listings.ts",
    "seed:postgres": "tsx scripts/seed-postgres.ts",
    "import-catalog": "tsx scripts/import-catalog.ts",
    "scrape-newme": "tsx scripts/scrape-newme-catalog.ts",
    "scrape-shein": "tsx scripts/scrape-shein-catalog.ts",
    "build-dataset": "tsx scripts/build-catalog-dataset.ts",
    "scrape-probes": "tsx scripts/scrape-probes/run-all.ts",
    "render-spike": "tsx scripts/render-spike.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1071.0",
    "@aws-sdk/s3-request-presigner": "^3.1071.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/jwt": "^9.0.2",
    "@fastify/multipart": "^9.0.3",
    "@sentry/node": "^9.30.0",
    "@worn/db": "workspace:*",
    "@worn/shared": "workspace:*",
    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^4.0.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^3.2.4",
    "form-data": "^4.0.2",
    "playwright": "^1.52.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  }
}
