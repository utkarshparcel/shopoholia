{
  "name": "worn",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev:api": "pnpm --filter @worn/api dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck",
    "check:eas-gates": "node scripts/check-eas-gates.mjs",
    "check:casa-track": "node scripts/check-casa-track.mjs",
    "check:store-listings": "node scripts/check-store-listings.mjs",
    "check:ops-playbooks": "node scripts/check-ops-playbooks.mjs",
    "check:dpdp-gdpr": "node scripts/check-dpdp-gdpr.mjs",
    "check:pentest-readiness": "node scripts/check-pentest-readiness.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "eslint": "^9.29.0",
    "turbo": "^2.5.4",
    "typescript-eslint": "^8.34.1"
  },
  "//": [
    "pnpm.overrides: fast-uri and @fastify/busboy are transitive (fast-uri via ajv/fast-json-stringify/@fastify/ajv-compiler, busboy via @fastify/multipart) and every parent already allows the fixed versions but the lockfile kept the old ones.",
    "fast-uri <3.1.7: SSRF / host confusion advisories. @fastify/busboy <3.2.1: multipart DoS advisory. Drop these once the lockfile resolves fixed versions on its own."
  ],
  "pnpm": {
    "patchedDependencies": {
      "expo-modules-jsi@56.0.10": "patches/expo-modules-jsi@56.0.10.patch"
    },
    "overrides": {
      "fast-uri@<3.1.7": "^3.1.9",
      "@fastify/busboy@<3.2.1": "^3.2.4"
    }
  }
}
